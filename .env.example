# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sap_middleware
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- SAP RFC connection ---
# When SAP_MOCK_MODE=true the middleware never opens a real RFC connection
# and instead returns realistic fake BAPI responses, so the whole stack can
# run and be demoed without access to an SAP system.
SAP_MOCK_MODE=true
SAP_ASHOST=sap-app-server.example.com
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=RFC_USER
SAP_PASSWD=change-me
SAP_LANG=EN
SAP_POOL_SIZE=2

# --- API ---
API_KEY=change-me
LOG_LEVEL=INFO

# --- Scheduler ---
# Minutes between automatic sync runs. Set to 0 to disable the scheduler
# and trigger syncs only via the API.
SYNC_INTERVAL_MINUTES=0
